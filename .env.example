# ---- Required ----
# An OpenAI-compatible API key. OpenAI directly, or OpenRouter (works from Iran).
OPENAI_API_KEY=

# ---- AI provider ----
# OpenRouter example: https://openrouter.ai/api/v1  (leave blank for OpenAI)
OPENAI_BASE_URL=
MODEL=gpt-4o-mini

# ---- Server ----
PORT=3009
# Origin allowed to embed the widget (CORS). Use the client's domain, e.g. https://myrestaurant.com
# Use * for testing only.
ALLOWED_ORIGIN=*

# ---- Owner-only endpoints (ingest, leads, conversations) ----
# Generate one with: node -e "console.log(require('crypto').randomUUID())"
ADMIN_KEY=

# ---- How the owner gets leads ----
# "log"      - write them to data/<site>/leads.json and print to the console
# "telegram" - also push every captured lead to a Telegram chat
# "both"     - both
NOTIFY_VIA=log
# Only used when NOTIFY_VIA is telegram or both:
BUSINESS_TELEGRAM_TOKEN=
BUSINESS_TELEGRAM_CHAT_ID=

# ---- Shown to visitors / used by the widget ----
BUSINESS_WHATSAPP=
BUSINESS_EMAIL=
# Shown as a small note at the bottom of the chat, e.g. "We reply to every message within one business day."
OFFLINE_MESSAGE=

# ---- Storage ----
# Where knowledge bases, conversations and leads live. Defaults to ./data
DATA_DIR=./data
